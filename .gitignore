# Keep local generation records, historical drafts and archives out of Git.
*
!/.gitignore
!/AGENTS.md
!/README.md
!/README.en.md
!/DEVELOPMENT.md
!/index.html
!/app.js
!/catalog.js
!/style.css
!/expressive.css
!/favicon.svg
!/serve.mjs
!/image-manifest-all.json
!/images/
!/images/look-*.webp
!/images-v2/
!/images-v2/look-*.webp
!/assets/
!/assets/model-bases/
!/assets/model-bases/female-01.webp
!/assets/looks/
!/assets/looks/**/
!/assets/looks/**/*.webp
!/content/
!/content/catalog.json
!/content/models.json
!/content/batch.schema.json
!/content/batches/
!/content/batches/*.json
!/content/batches/.gitkeep
!/scripts/
!/scripts/*.mjs
!/.github/
!/.github/workflows/
!/.github/workflows/check.yml
!/qa/
!/qa/regression-expressive.mjs
!/qa/regression-assets.mjs
!/docs/
!/docs/deployment-feasibility.md
!/docs/ai-tryon-backend-design.md
!/docs/external-agent-sop.md
!/docs/content-publishing-plan.md
!/docs/images/
!/docs/images/wardrobe-preview.webp
# Backend and admin source only; runtime data, credentials, models and venv stay ignored.
!/pyproject.toml
!/uv.lock
!/backend/
!/backend/**/
!/backend/**/*.py
!/backend/README.md
!/tests/
!/tests/backend/
!/tests/backend/**/
!/tests/backend/**/*.py
!/tests/ui_bridge.py
!/admin/
!/admin/*.html
!/admin/*.js
!/admin/*.mjs
!/admin/package.json
!/admin/package-lock.json
!/admin/*.css
!/tryon.js
!/tryon.css
!/qa/regression-tryon.mjs
!/qa/regression-admin.mjs
!/qa/regression-catalog-export.mjs
!/qa/regression-deploy.mjs
!/qa/regression-ci.mjs
!/qa/regression-integration.mjs
!/qa/regression-content.mjs
!/qa/regression-homepage.mjs
!/qa/regression-release.mjs
!/deploy/
!/deploy/*.py
!/deploy/*.service
!/deploy/*.conf
!/deploy/*.md
