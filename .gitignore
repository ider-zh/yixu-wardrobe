# Keep local generation records, historical drafts and archives out of Git.
*
!/.gitignore
!/AGENTS.md
!/README.md
!/README.en.md
!/DEVELOPMENT.md
!/index.html
!/app.js
!/catalog.js
!/style.css
!/expressive.css
!/favicon.svg
!/serve.mjs
!/image-manifest-all.json
!/images/
!/images/look-*.png
!/images-v2/
!/images-v2/look-*.png
!/scripts/
!/scripts/*.mjs
!/.github/
!/.github/workflows/
!/.github/workflows/check.yml
!/qa/
!/qa/regression-expressive.mjs
!/docs/
!/docs/deployment-feasibility.md
!/docs/images/
!/docs/images/wardrobe-preview.png
