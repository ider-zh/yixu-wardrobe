[Unit]
Description=Yixu development image worker (isolated queue)
After=network-online.target yixu-dev-api.service
Wants=network-online.target
ConditionPathExists=/srv/yixu-wardrobe-dev/current/.venv/bin/python

[Service]
Type=simple
User=yixu-dev
Group=yixu-dev
WorkingDirectory=/srv/yixu-wardrobe-dev/current
EnvironmentFile=/etc/yixu-wardrobe-dev/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/srv/yixu-wardrobe-dev/current/.venv/bin/python -m backend.worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=3700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yixu-wardrobe-dev
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
